# SiegeIQ Sync - what never goes into the public repo.
#
# ffmpeg.exe is ~99 MB and is not ours to redistribute in source form. It is
# fetched at build time and shipped inside the installer instead, which is
# where its LGPL notice travels with it. GitHub also rejects any file over
# 100 MB outright, so committing it once would wedge the repo history.
ffmpeg/ffmpeg.exe

# Build output. The exe and the installer are RELEASE ASSETS, not source.
SiegeIQSync.exe
SiegeIQSync-*.exe
installer/dist/

# Working files from the Claude sessions.
_to_delete/
_update-*.tgz
_meta.tgz
*.tgz

# Local editor and OS noise.
.vscode/
*.log
Thumbs.db
desktop.ini
