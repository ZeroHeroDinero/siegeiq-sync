# Build output
*.exe
*.old
SHA256SUMS.txt

# Generated by go-winres (rebuilt by build.bat / CI on every build)
*.syso

# Installer output + signing scratch dirs (produced by CI / build.bat)
installer/dist/
signed/

# Local-only build helpers (side modfile used to build behind a proxy)
go.local.mod
go.local.sum

# Local runtime state (normally lives in %APPDATA%\SiegeIQSync\, but ignore if ever present here)
config.json
state.json
sync.log

# OS / editor cruft
.DS_Store
Thumbs.db
